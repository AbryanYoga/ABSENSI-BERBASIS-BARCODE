// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Karyawan {
  id           String    @id @default(uuid())
  nama_lengkap String
  jabatan      String
  qr_code_id   String    @unique
  absensi      Absensi[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("karyawan")
}

model Pengaturan {
  id               Int      @id @default(1)
  jam_masuk_normal String   @default("08:00:00")
  updatedAt        DateTime @updatedAt

  @@map("pengaturan")
}

model Absensi {
  id           String    @id @default(uuid())
  karyawan_id  String
  tanggal      DateTime
  waktu_masuk  DateTime?
  waktu_pulang DateTime?
  status_masuk String // "Tepat Waktu" | "Terlambat" | "Alpha"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  karyawan Karyawan @relation(fields: [karyawan_id], references: [id], onDelete: Cascade)

  @@unique([karyawan_id, tanggal])
  @@index([tanggal])
  @@index([karyawan_id])
  @@map("absensi")
}
